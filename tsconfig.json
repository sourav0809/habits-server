{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "lib": ["es6"],

    "outDir": "build",
    "rootDir": "src",

    "baseUrl": "src",
    "paths": {
      "@/*": ["*"],
      "@/constants/*": ["constants/*"],
      "@/config/*": ["config/*"]
    },

    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build"]
}
