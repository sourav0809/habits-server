{
  "name": "Node Js Starter Project With Typescript",
  "version": "1.0.0",
  "description": "Production-ready Node.js backend with TypeScript and MongoDB",
  "main": "build/index.js",
  "scripts": {
    "lint": "eslint . --ext .ts",
    "build": "tsc",
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/index.ts",
    "start": "node -r tsconfig-paths/register build/index.js",
    "start:prod": "pm2 startOrRestart ./pm2/ecosystem.prod.config.json --only habits-prod"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.0",
    "mongoose": "^8.16.0",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/joi": "^17.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
